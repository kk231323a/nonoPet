{
  "name": "bubu-desktop-pet",
  "version": "0.2.2",
  "private": true,
  "description": "A soft fan-made desktop companion inspired by the visual language of Yier Bubu.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "start": "electron .",
    "build": "tsc --noEmit && vite build",
    "icons": "node scripts/make-icons.mjs",
    "postinstall": "node scripts/make-icons.mjs",
    "preview": "vite preview",
    "dist:win": "pnpm build && pnpm icons && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "local.bubu.desktop-pet",
    "productName": "布布桌宠",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/tray.png",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BubuDesktopPet-${version}-portable.${ext}"
    }
  }
}
